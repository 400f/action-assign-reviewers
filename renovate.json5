// Mirrors local>400f/renovate-config, which this public repository cannot read because the preset repository is private.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    ':separateMultipleMajorReleases',
    ':timezone(Asia/Tokyo)',
  ],
  schedule: ['* 10-17 1,15 * *'],
  minimumReleaseAge: '14 days',
  labels: ['renovate'],
  npm: {
    rangeStrategy: 'bump',
  },
  vulnerabilityAlerts: {
    labels: ['security'],
    minimumReleaseAge: null,
    schedule: ['at any time'],
    automerge: false,
  },
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
      groupName: 'minor and patch dependencies',
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
      groupName: 'github actions dependencies',
    },
    {
      // action.yml runs on node24; keep the local toolchain and types on the same major.
      matchDepNames: ['node', '@types/node'],
      allowedVersions: '<25',
    },
  ],
}
