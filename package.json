{
  "name": "@400f/action-assign-reviewers",
  "version": "0.0.1",
  "private": true,
  "description": "A Github action workflow that assign reviewers and team reviewers.",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/400f/action-assign-reviewers.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "400F",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^8.57.1",
    "eslint-plugin-github": "^4.10.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "js-yaml": "^4.3.2",
    "prettier": "3.9.10",
    "typescript": "^5.9.3"
  }
}
